    "tokenColors": [
        {
            "scope": [
                "comment",
                "comment.line",
                "comment.block"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#737373"
            }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.import",
                "keyword.operator",
                "storage",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "fontStyle": "bold italic",
                "foreground": "#FF405C"
            }
        },
        {
            "scope": [
                "constant",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#FFB300"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#FF8A3D"
            }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.template"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#C6D94A"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "variable.function"
            ],
            "settings": {
                "fontStyle": "bold italic",
                "foreground": "#FFD166"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "support.type",
                "storage.type.class"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#C792EA"
            }
        },
        {
            "scope": [
                "entity.name.namespace",
                "entity.name.module",
                "support.module"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#B8A1FF"
            }
        },
        {
            "scope": [
                "variable",
                "variable.other",
                "variable.parameter",
                "meta.definition.variable"
            ],
            "settings": {
                "foreground": "#E8E8E8"
            }
        },
        {
            "scope": [
                "variable.other.constant",
                "variable.other.enummember"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#FFB300"
            }
        },
        {
            "scope": [
                "variable.other.property",
                "meta.object-literal.key",
                "support.type.property-name"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#48CAE4"
            }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html"
            ],
            "settings": {
                "fontStyle": "bold italic",
                "foreground": "#FF9F1C"
            }
        },
        {
            "scope": [
                "entity.name.tag",
                "entity.name.tag.html",
                "entity.name.tag.xml"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#FF4FA3"
            }
        },
        {
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": {
                "foreground": "#D8D8D8"
            }
        },
        {
            "scope": [
                "punctuation.definition",
                "punctuation.accessor",
                "punctuation.section"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#FFFFFF"
            }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.logical"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#FF5F56"
            }
        },
        {
            "scope": [
                "support.constant",
                "support.variable"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#00C2A8"
            }
        },
        {
            "scope": [
                "support.type.primitive",
                "support.type.builtin"
            ],
            "settings": {
                "fontStyle": "italic bold",
                "foreground": "#7DD3F2"
            }
        },
        {
            "scope": [
                "entity.name.label",
                "entity.name.section"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#E4A853"
            }
        },
        {
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "background": "#8F1111",
                "fontStyle": "bold",
                "foreground": "#FFFFFF"
            }
        },
        {
            "scope": [
                "markup.heading",
                "markup.heading.markdown"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#FFB300"
            }
        },
        {
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#FFD166"
            }
        },
        {
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#C792EA"
            }
        },
        {
            "scope": [
                "markup.quote"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#00C2A8"
            }
        },
        {
            "scope": [
                "markup.inline.raw",
                "markup.fenced_code"
            ],
            "settings": {
                "foreground": "#C6D94A"
            }
        }
    ]
}