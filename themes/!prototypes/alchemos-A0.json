    "tokenColors": [
        {
            "scope": [
                "keyword",
                "keyword.operator",
                "keyword.control",
                "storage.type"
            ],
            "settings": {
                "foreground": "#FF0000",
                "fontStyle": "italic bold"
            }
        },
        {
            "scope": [
                "variable",
                "variable.other",
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#EEEEEE"
            }
        },
        {
            "scope": "punctuation",
            "settings": {
                "foreground": "#FFFFFF",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "meta.function-call",
                "entity.name.type",
                "support.class"
            ],
            "settings": {
                "foreground": "#fabe1e",
                "fontStyle": "italic bold"
            }
        },
        {
            "scope": [
                "variable.other.object",
                "punctuation.definition",
                "meta.attribute"
            ],
            "settings": {
                "foreground": "#00FFFF"
            }
        },
        {
            "scope": "comment",
            "settings": {
                "foreground": "#666666",
                "fontStyle": "italic bold"
            }
        },
        {
            "scope": [
                "meta.object-literal.key",
                "support.type"
            ],
            "settings": {
                "foreground": "#AA00FF",
                "fontStyle": "italic bold"
            }
        },
        {
            "scope": [
                "source",
                "text.html"
            ],
            "settings": {
                "foreground": "#CCCCCC"
            }
        },
        {
            "scope": [
                "entity.name.tag",
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#FF0073",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "variable.other.property",
                "meta.function-call.arguments"
            ],
            "settings": {
                "foreground": "#00A0FF"
            }
        },
        {
            "scope": [
                "keyword.control.flow",
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#FF6600",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#BF6900",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#AA0000",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.template"
            ],
            "settings": {
                "foreground": "#aabe14"
            }
        }
    ]
}