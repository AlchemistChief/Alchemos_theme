    "tokenColors": [
        {
            "scope": [
                "punctuation.definition.tag",
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag.end",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.xml",
                "punctuation.definition.tag.attribute"
            ],
            "settings": {
                "foreground": "#2CA3AF"
            }
        },
        {
            "scope": [
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#AE3248",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "comment",
                "comment.line",
                "comment.block"
            ],
            "settings": {
                "foreground": "#545454",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.import",
                "storage",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#AE3248",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "constant",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": {
                "foreground": "#B08E28",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float"
            ],
            "settings": {
                "foreground": "#B06528"
            }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.template"
            ],
            "settings": {
                "foreground": "#92A82C"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "variable.function"
            ],
            "settings": {
                "foreground": "#B09B28",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "storage.type.class"
            ],
            "settings": {
                "foreground": "#88349C",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "entity.name.namespace",
                "entity.name.module",
                "support.module"
            ],
            "settings": {
                "foreground": "#77349C",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "variable",
                "variable.other",
                "meta.definition.variable"
            ],
            "settings": {
                "foreground": "#CCCCCC"
            }
        },
        {
            "scope": [
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#EAEAEA",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "variable.other.constant"
            ],
            "settings": {
                "foreground": "#CCCCCC",
                "fontStyle": ""
            }
        },
        {
            "scope": [
                "variable.other.enummember"
            ],
            "settings": {
                "foreground": "#B09828",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "variable.other.property",
                "meta.object-literal.key",
                "support.type.property-name"
            ],
            "settings": {
                "foreground": "#2CA3AF"
            }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html"
            ],
            "settings": {
                "foreground": "#B08528"
            }
        },
        {
            "scope": [
                "entity.name.tag",
                "entity.name.tag.html",
                "entity.name.tag.xml"
            ],
            "settings": {
                "foreground": "#AE2D65",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": {
                "foreground": "#A8A8A8"
            }
        },
        {
            "scope": [
                "punctuation.definition",
                "punctuation.accessor",
                "punctuation.section"
            ],
            "settings": {
                "foreground": "#EAEAEA"
            }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.logical"
            ],
            "settings": {
                "foreground": "#AE4523"
            }
        },
        {
            "scope": [
                "support.constant",
                "support.variable"
            ],
            "settings": {
                "foreground": "#2CA3AF"
            }
        },
        {
            "scope": [
                "support.type.primitive",
                "support.type.builtin"
            ],
            "settings": {
                "foreground": "#2C8AA8"
            }
        },
        {
            "scope": [
                "entity.name.label",
                "entity.name.section"
            ],
            "settings": {
                "foreground": "#B08528",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "entity.name.tag.css",
                "entity.name.selector.css"
            ],
            "settings": {
                "foreground": "#AE2D65",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#EAEAEA",
                "background": "#63131D",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.heading",
                "markup.heading.markdown"
            ],
            "settings": {
                "foreground": "#B09828",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "foreground": "#B09B28",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "foreground": "#88349C",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "markup.quote"
            ],
            "settings": {
                "foreground": "#2CA3AF",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "markup.inline.raw",
                "markup.fenced_code"
            ],
            "settings": {
                "foreground": "#92A82C"
            }
        },
        {
            "scope": [
                "storage.type.interface",
                "keyword.interface"
            ],
            "settings": {
                "foreground": "#AE3248",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "entity.name.type.interface",
                "entity.name.interface"
            ],
            "settings": {
                "foreground": "#B04667",
                "fontStyle": "bold"
            }
        }
    ]
}