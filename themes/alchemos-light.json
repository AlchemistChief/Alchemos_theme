        "editorWidget.border": "#D0D0D0",
        "extensionButton.prominentBackground": "#007766",
        "extensionButton.prominentForeground": "#FFFFFF",
        "focusBorder": "#0044BB",
        "foreground": "#121212",
        "gitDecoration.addedResourceForeground": "#007733",
        "gitDecoration.conflictingResourceForeground": "#B30000",
        "gitDecoration.deletedResourceForeground": "#CC0000",
        "gitDecoration.ignoredResourceForeground": "#888888",
        "gitDecoration.modifiedResourceForeground": "#AA5500",
        "gitDecoration.untrackedResourceForeground": "#006600",
        "input.background": "#FFFFFF",
        "input.border": "#D0D0D0",
        "input.foreground": "#121212",
        "input.placeholderForeground": "#777777",
        "inputOption.activeBorder": "#0044BB",
        "inputValidation.errorBorder": "#B30000",
        "inputValidation.infoBorder": "#005577",
        "inputValidation.warningBorder": "#AA5500",
        "list.activeSelectionBackground": "#E0E0E0",
        "list.activeSelectionForeground": "#000000",
        "list.focusBackground": "#E8E8E8",
        "list.highlightForeground": "#0044BB",
        "list.hoverBackground": "#F0F0F0",
        "list.inactiveSelectionBackground": "#F0F0F0",
        "notification.background": "#F5F5F5",
        "notification.buttonBackground": "#E0E0E0",
        "notification.errorBackground": "#FFCCCC",
        "notification.foreground": "#121212",
        "notification.infoBackground": "#CCE8E8",
        "notification.warningBackground": "#FFE5B2",
        "panel.background": "#FFFFFF",
        "panel.border": "#D0D0D0",
        "panelTitle.activeBorder": "#0044BB",
        "panelTitle.activeForeground": "#0044BB",
        "panelTitle.inactiveForeground": "#777777",
        "peekView.border": "#0044BB",
        "peekViewEditor.background": "#F5F5F5",
        "peekViewResult.background": "#FFFFFF",
        "peekViewResult.fileForeground": "#0044BB",
        "peekViewResult.lineForeground": "#555555",
        "peekViewResult.selectionBackground": "#E0E0E0",
        "peekViewTitle.background": "#FFFFFF",
        "scrollbarSlider.background": "#00000022",
        "scrollbarSlider.hoverBackground": "#00000044",
        "scrollbarSlider.activeBackground": "#00000066",
        "sideBar.background": "#F5F5F5",
        "sideBar.border": "#D0D0D0",
        "sideBar.foreground": "#333333",
        "sideBarSectionHeader.background": "#F5F5F5",
        "sideBarSectionHeader.foreground": "#0044BB",
        "statusBar.background": "#F5F5F5",
        "statusBar.foreground": "#B30000",
        "statusBar.noFolderBackground": "#E8E8E8",
        "statusBar.noFolderForeground": "#0044BB",
        "statusBarItem.hoverBackground": "#E0E0E0",
        "statusBarItem.prominentBackground": "#0044BB",
        "statusBarItem.prominentForeground": "#FFFFFF",
        "tab.activeBackground": "#FFFFFF",
        "tab.activeBorder": "#B30000",
        "tab.activeForeground": "#B30000",
        "tab.inactiveBackground": "#F5F5F5",
        "tab.inactiveForeground": "#777777",
        "tab.unfocusedActiveBorder": "#CC6677",
        "tab.unfocusedActiveForeground": "#CC6677",
        "terminal.ansiBlack": "#000000",
        "terminal.ansiBlue": "#0044BB",
        "terminal.ansiBrightBlack": "#555555",
        "terminal.ansiBrightBlue": "#0055CC",
        "terminal.ansiBrightCyan": "#0088AA",
        "terminal.ansiBrightGreen": "#008800",
        "terminal.ansiBrightMagenta": "#8800AA",
        "terminal.ansiBrightRed": "#CC0000",
        "terminal.ansiBrightWhite": "#121212",
        "terminal.ansiBrightYellow": "#AA7700",
        "terminal.ansiCyan": "#006688",
        "terminal.ansiGreen": "#006600",
        "terminal.ansiMagenta": "#6A0080",
        "terminal.ansiRed": "#B30000",
        "terminal.ansiWhite": "#333333",
        "terminal.ansiYellow": "#885500",
        "terminal.background": "#FFFFFF",
        "terminal.foreground": "#121212",
        "terminalCursor.foreground": "#0044BB",
        "titleBar.activeBackground": "#FFFFFF",
        "titleBar.activeForeground": "#B30000",
        "titleBar.inactiveBackground": "#F5F5F5",
        "titleBar.inactiveForeground": "#888888",
        "menu.background": "#FFFFFF",
        "menu.foreground": "#121212",
