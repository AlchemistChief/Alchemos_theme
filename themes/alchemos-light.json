        "menu.selectionBackground": "#E0E0E0",
        "menu.selectionForeground": "#0044BB",
        "menu.separatorBackground": "#D0D0D0"
    },
    "tokenColors": [
        {
            "scope": [
                "punctuation.definition.tag",
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag.end",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.xml",
                "punctuation.definition.tag.attribute"
            ],
            "settings": {
                "foreground": "#005577"
            }
        },
        {
            "scope": [
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#B30000",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "comment",
                "comment.line",
                "comment.block"
            ],
            "settings": {
                "foreground": "#667788",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.import",
                "storage",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#B30000",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "constant",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": {
                "foreground": "#885500",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float"
            ],
            "settings": {
                "foreground": "#AA3300"
            }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.template"
            ],
            "settings": {
                "foreground": "#006600"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "variable.function"
            ],
            "settings": {
                "foreground": "#0044BB",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "storage.type.class"
            ],
            "settings": {
                "foreground": "#6A0080",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "entity.name.namespace",
                "entity.name.module",
                "support.module"
            ],
            "settings": {
                "foreground": "#550088",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "variable",
                "variable.other",
                "meta.definition.variable"
            ],
            "settings": {
                "foreground": "#121212"
            }
        },
        {
            "scope": [
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#333333",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "variable.other.constant"
            ],
            "settings": {
                "foreground": "#121212",
                "fontStyle": ""
            }
        },
        {
            "scope": [
                "variable.other.enummember"
            ],
            "settings": {
                "foreground": "#995500",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "variable.other.property",
                "meta.object-literal.key",
                "support.type.property-name"
            ],
            "settings": {
                "foreground": "#005577"
            }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html"
            ],
            "settings": {
                "foreground": "#AA4400"
            }
        },
        {
            "scope": [
                "entity.name.tag",
                "entity.name.tag.html",
                "entity.name.tag.xml"
            ],
            "settings": {
                "foreground": "#990044",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": {
                "foreground": "#555555"
            }
        },
        {
            "scope": [
                "punctuation.definition",
                "punctuation.accessor",
                "punctuation.section"
            ],
            "settings": {
                "foreground": "#121212"
            }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.logical"
            ],
            "settings": {
                "foreground": "#CC2200"
            }
        },
        {
            "scope": [
                "support.constant",
                "support.variable"
            ],
            "settings": {
                "foreground": "#005577"
            }
        },
        {
            "scope": [
                "support.type.primitive",
                "support.type.builtin"
            ],
            "settings": {
                "foreground": "#006699"
            }
        },
        {
            "scope": [
                "entity.name.label",
                "entity.name.section"
            ],
            "settings": {
                "foreground": "#AA4400",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "entity.name.tag.css",
                "entity.name.selector.css"
            ],
            "settings": {
                "foreground": "#990044",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#FFFFFF",
                "background": "#B30000",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.heading",
                "markup.heading.markdown"
            ],
            "settings": {
                "foreground": "#0044BB",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "foreground": "#0044BB",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "foreground": "#6A0080",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "markup.quote"
            ],
            "settings": {
                "foreground": "#005577",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "markup.inline.raw",
                "markup.fenced_code"
            ],
            "settings": {
                "foreground": "#006600"
            }
        },
        {
            "scope": [
                "storage.type.interface",
                "keyword.interface"
            ],
            "settings": {
                "foreground": "#B30000",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "entity.name.type.interface",
                "entity.name.interface"
            ],
            "settings": {
                "foreground": "#B30047",
                "fontStyle": "bold"
            }
        }
    ]
}