{
    "name": "Alchemos LIGHT",
    "version": "v1",
    "type": "light",
    "semanticTokenColors": {
        "class": "#6A0080",
        "comment": "#667788",
        "decorator": "#B30047",
        "enum": "#885500",
        "enumMember": "#995500",
        "function": "#0044BB",
        "interface": "#B30047",
        "keyword": "#B30000",
        "label": "#AA4400",
        "method": "#0044BB",
        "modifier": "#B30000",
        "namespace": "#550088",
        "number": "#AA3300",
        "operator": "#CC2200",
        "parameter": "#333333",
        "property": "#005577",
        "string": "#006600",
        "type": "#0044BB",
        "variable": "#121212"
