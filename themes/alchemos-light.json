        "dropdown.foreground": "#121212",
        "editor.background": "#FFFFFF",
        "editor.foreground": "#121212",
        "editor.findMatchBackground": "#FFD000",
        "editor.findMatchForeground": "#000000",
        "editor.findMatchHighlightBackground": "#FFE566",
        "editor.findRangeHighlightBackground": "#FFF099",
        "editor.inactiveSelectionBackground": "#E8E8E8",
