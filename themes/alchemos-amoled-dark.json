    "tokenColors": [
        {
            "scope": [
                "punctuation.definition.tag",
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag.end",
                "punctuation.definition.tag.html",
                "punctuation.definition.tag.xml",
                "punctuation.definition.tag.attribute"
            ],
            "settings": {
                "foreground": "#00E5FF"
            }
        },
        {
            "scope": [
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#FF1744",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "comment",
                "comment.line",
                "comment.block"
            ],
            "settings": {
                "foreground": "#666666",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.import",
                "storage",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#FF1744",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "constant",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": {
                "foreground": "#FFC400",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float"
            ],
            "settings": {
                "foreground": "#FF6D00"
            }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.template"
            ],
            "settings": {
                "foreground": "#C6FF00"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "variable.function"
            ],
            "settings": {
                "foreground": "#FFD600",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class",
                "storage.type.class"
            ],
            "settings": {
                "foreground": "#D500F9",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "entity.name.namespace",
                "entity.name.module",
                "support.module"
            ],
            "settings": {
                "foreground": "#AA00FF",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "variable",
                "variable.other",
                "meta.definition.variable"
            ],
            "settings": {
                "foreground": "#F5F5F5"
            }
        },
        {
            "scope": [
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#FFFFFF",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "variable.other.constant"
            ],
            "settings": {
                "foreground": "#F5F5F5",
                "fontStyle": ""
            }
        },
        {
            "scope": [
                "variable.other.enummember"
            ],
            "settings": {
                "foreground": "#FFD000",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "variable.other.property",
                "meta.object-literal.key",
                "support.type.property-name"
            ],
            "settings": {
                "foreground": "#00E5FF"
            }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html"
            ],
            "settings": {
                "foreground": "#FFAB00"
            }
        },
        {
            "scope": [
                "entity.name.tag",
                "entity.name.tag.html",
                "entity.name.tag.xml"
            ],
            "settings": {
                "foreground": "#FF0080",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": {
                "foreground": "#D0D0D0"
            }
        },
        {
            "scope": [
                "punctuation.definition",
                "punctuation.accessor",
                "punctuation.section"
            ],
            "settings": {
                "foreground": "#FFFFFF"
            }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.logical"
            ],
            "settings": {
                "foreground": "#FF3D00"
            }
        },
        {
            "scope": [
                "support.constant",
                "support.variable"
            ],
            "settings": {
                "foreground": "#00E5FF"
            }
        },
        {
            "scope": [
                "support.type.primitive",
                "support.type.builtin"
            ],
            "settings": {
                "foreground": "#00B8FF"
            }
        },
        {
            "scope": [
                "entity.name.label",
                "entity.name.section"
            ],
            "settings": {
                "foreground": "#FFAB00",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "entity.name.tag.css",
                "entity.name.selector.css"
            ],
            "settings": {
                "foreground": "#FF0080",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#FFFFFF",
                "background": "#8F0015",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.heading",
                "markup.heading.markdown"
            ],
            "settings": {
                "foreground": "#FFD000",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "foreground": "#FFD600",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "foreground": "#D500F9",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "markup.quote"
            ],
            "settings": {
                "foreground": "#00E5FF",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "markup.inline.raw",
                "markup.fenced_code"
            ],
            "settings": {
                "foreground": "#C6FF00"
            }
        },
        {
            "scope": [
                "storage.type.interface",
                "keyword.interface"
            ],
            "settings": {
                "foreground": "#FF1744",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "entity.name.type.interface",
                "entity.name.interface"
            ],
            "settings": {
                "foreground": "#FF4081",
                "fontStyle": "bold"
            }
        }
    ]
}